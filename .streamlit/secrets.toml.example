# Copie este arquivo para .streamlit/secrets.toml e preencha com a connection
# string do seu projeto Supabase (Project Settings > Database > Connection string
# > URI). O secrets.toml real NUNCA deve ser commitado (já está no .gitignore).
#
# Sem esse arquivo (ou sem a variável de ambiente DATABASE_URL), o app usa
# SQLite local automaticamente — nada muda para quem só quer testar na máquina.

DATABASE_URL = "postgresql://postgres:SUA_SENHA@db.SEU-PROJETO.supabase.co:5432/postgres"
